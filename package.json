{
  "name": "ninja-engine",
  "version": "0.12.0",
  "private": true,
  "description": "Ninja Engine — standalone 2D RPG editor/runtime with desktop and Android packaging",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "desktop:build": "npm run desktop:installer && npm run desktop:portable",
    "desktop:installer": "electron-builder --win nsis --publish never -c.artifactName=Ninja-Engine-Setup-v${version}-${arch}.${ext}",
    "desktop:portable": "electron-builder --win portable --publish never -c.artifactName=Ninja-Engine-Portable-v${version}-${arch}.${ext}",
    "android:prepare": "node tools/android-prepare.cjs",
    "android:build": "node tools/android-build.cjs",
    "android:debug": "node tools/android-build.cjs debug",
    "android:release": "node tools/android-build.cjs release"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ninjaengine.editor",
    "productName": "Ninja Engine",
    "artifactName": "Ninja-Engine-v${version}-${arch}.${ext}",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ninja Engine"
    }
  }
}
